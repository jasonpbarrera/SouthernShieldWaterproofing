@page "/"
@inject IOptions<BusinessSettings> BusinessConfig
@inject IOptions<HomePageSettings> HomeConfig
@inject IOptions<ContactPageSettings> ContactConfig
@inject HttpClient Http

<PageTitle>@BusinessConfig.Value.ShortName | Foundation Waterproofing, Footing Treatment &amp; French Drains</PageTitle>

<!-- CONTRACTOR SPLIT HERO SECTION -->
<section class="contractor-hero">
    <div class="hero-container">
        <!-- Left: Trade Positioning & Direct Call Actions -->
        <div class="hero-text-col">
            <div class="hero-kicker">
                🛡️ SUB-GRADE FOUNDATION DEFENSE &amp; SITE DRAINAGE
            </div>
            <h1 class="hero-headline">
                STOP WATER AT THE FOOTING.<br />
                <span>BUILT FOR TENNESSEE CLAY.</span>
            </h1>
            <p class="hero-lead">
                We spray commercial-grade elastomeric polymer membranes, seal footing cold-joints, install heavy dimpled backfill armor, and trench laser-graded French drains across Southeast Tennessee. Owner Scotty Barrera is on-site running the rig on every project.
            </p>
            <div class="hero-cta-row">
                <a href="tel:@BusinessConfig.Value.PhoneNumber" class="btn btn-safety hero-call-btn">
                    <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1C10.61 21 3 13.39 3 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.25 1.01l-2.2 2.2z"/></svg>
                    <span>Call Scotty: @BusinessConfig.Value.PhoneNumber</span>
                </a>
                <a href="#services" class="btn btn-secondary hero-services-btn">
                    <span>View Capabilities &darr;</span>
                </a>
            </div>
            <div class="hero-proof-list">
                <span>✓ 100% Owner Operated</span>
                <span>✓ Commercial Polymer (No Tar)</span>
                <span>✓ Footing Cold-Joint Sealing</span>
                <span>✓ Washed Stone Drainage</span>
            </div>
        </div>

        <!-- Right: Functional Contractor Quick Inspection Card -->
        <div class="hero-intake-card">
            <div class="intake-header">
                <h3>Request Free Inspection</h3>
                <p>Direct assessment from Scotty Barrera within 24–48 hours.</p>
            </div>

            @if (isSubmitted)
            {
                <div class="intake-success-box">
                    <div class="success-icon">✓</div>
                    <h4>Request Received!</h4>
                    <p>Thank you, <strong>@leadName</strong>. Scotty Barrera will review your foundation details and call you at <strong>@leadPhone</strong> shortly.</p>
                    <button class="btn btn-secondary btn-sm" @onclick="ResetIntakeForm" style="margin-top: 1rem;">
                        Submit Another Request
                    </button>
                </div>
            }
            else
            {
                <form class="intake-form" @onsubmit="SubmitQuickInspectionAsync" @onsubmit:preventDefault>
                    <div class="form-group">
                        <label for="leadName">Your Name</label>
                        <input id="leadName" type="text" @bind="leadName" placeholder="John Doe" required />
                    </div>

                    <div class="form-group">
                        <label for="leadPhone">Phone Number</label>
                        <input id="leadPhone" type="tel" @bind="leadPhone" placeholder="(423) 555-0123" required />
                    </div>

                    <div class="form-group">
                        <label for="leadService">Project Type</label>
                        <select id="leadService" @bind="leadService">
                            <option value="New Foundation Waterproofing">New Foundation Waterproofing</option>
                            <option value="Footing Cold-Joint Sealing">Footing Cold-Joint Sealing</option>
                            <option value="Exterior French Drainage &amp; Runoff">Exterior French Drainage &amp; Runoff</option>
                            <option value="Dimpled Backfill Armor Board">Dimpled Backfill Armor Board</option>
                            <option value="Full Foundation Defense Package">Full Foundation Defense Package</option>
                            <option value="Free On-Site Inspection">Free On-Site Inspection</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="leadCity">Job Location / City</label>
                        <input id="leadCity" type="text" @bind="leadCity" placeholder="Cleveland, Chattanooga, Ooltewah, etc." required />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(submissionError))
                    {
                        <div class="intake-error">@submissionError</div>
                    }

                    <button type="submit" class="intake-submit-btn" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span>Sending Details...</span>
                        }
                        else
                        {
                            <span>Get Free Site Inspection &rarr;</span>
                        }
                    </button>
                    <div class="intake-note">
                        No high-pressure sales reps. Scotty visits your job site personally.
                    </div>
                </form>
            }
        </div>
    </div>
</section>

<!-- SECTION 2: 3 CORE CONTRACTOR TRADE SPECIALTIES -->
<section class="services-overview-section" id="services">
    <div class="container">
        <div class="section-header-clean">
            <span class="section-tag-trade">Specialized Sub-Grade Contracting</span>
            <h2 class="section-title-clean">Our Foundation Defense Services</h2>
            <p class="section-subtitle-clean">
                Targeted solutions designed to withstand hydrostatic pressure, soil moisture, and heavy mountain runoff.
            </p>
        </div>

        <div class="trade-cards-grid">
            <!-- Card 1 -->
            <div class="trade-card">
                <div class="trade-icon-header">
                    <ShieldIcon Name="membrane" CssClass="trade-svg" />
                </div>
                <h3>Polymer Spray Membrane</h3>
                <p>
                    Applied at high pressure to form an impenetrable, seamless elastomeric rubber envelope. Unlike brittle tar, our polymer stretches up to 800% to bridge foundation settling cracks without tearing.
                </p>
                <ul class="trade-bullets">
                    <li><span>✓</span> 100% Seamless Monolithic Coverage</li>
                    <li><span>✓</span> Bridges Settling &amp; Shrinkage Cracks</li>
                    <li><span>✓</span> Subterranean Hydrostatic Rated</li>
                </ul>
            </div>

            <!-- Card 2 -->
            <div class="trade-card">
                <div class="trade-icon-header">
                    <ShieldIcon Name="footing" CssClass="trade-svg" />
                </div>
                <h3>Footing Cold-Joint Seal</h3>
                <p>
                    Where your foundation wall meets the concrete footing is the #1 entry point for groundwater. We clean and apply a continuous elastomeric waterstop barrier across the keyway to stop wicking.
                </p>
                <ul class="trade-bullets">
                    <li><span>✓</span> Sub-Grade Keyway Cold-Joint Sealing</li>
                    <li><span>✓</span> Blocks Capillary Ground Water Wicking</li>
                    <li><span>✓</span> Protects Basement Slab Perimeter</li>
                </ul>
            </div>

            <!-- Card 3 -->
            <div class="trade-card">
                <div class="trade-icon-header">
                    <ShieldIcon Name="french-drain" CssClass="trade-svg" />
                </div>
                <h3>French Drainage &amp; Armor</h3>
                <p>
                    High-density dimpled HDPE drainage board protects the rubber membrane from machine backfill rock punctures while perforated pipe bedded in washed river rock carries footing water to daylight.
                </p>
                <ul class="trade-bullets">
                    <li><span>✓</span> Dimpled Armor Shields During Backfill</li>
                    <li><span>✓</span> Clean Washed River Rock Bedding</li>
                    <li><span>✓</span> Non-Woven Geotextile Silt Filtration</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- SECTION 3: ARCHITECTURAL BLUEPRINT (STEP BY STEP) -->
<section class="blueprint-section">
    <div class="container">
        <div class="blueprint-layout">
            <div class="blueprint-info">
                <span class="section-tag-trade">Engineering Standard</span>
                <h2>The 4-Layer Foundation Envelope</h2>
                <p>
                    Waterproofing is an engineered system, not a coat of paint. Here is how Southern Shield builds a permanent sub-grade defense from footing to grade.
                </p>

                <div class="blueprint-stack">
                    <div class="blueprint-step-card">
                        <span class="step-num">01</span>
                        <div class="step-body">
                            <h4>Footing Preparation &amp; Cold-Joint Seal</h4>
                            <p>We excavate and clean the virgin footing, applying an elastomeric hydro-stop bead directly along the wall-to-footing keyway seam.</p>
                        </div>
                    </div>

                    <div class="blueprint-step-card">
                        <span class="step-num">02</span>
                        <div class="step-body">
                            <h4>High-Build Polymer Spray Membrane</h4>
                            <p>Commercial-grade rubberized polymer sprayed under pressure across the entire foundation face, creating a flexible, seamless waterproof barrier.</p>
                        </div>
                    </div>

                    <div class="blueprint-step-card">
                        <span class="step-num">03</span>
                        <div class="step-body">
                            <h4>Dimpled HDPE Backfill Armor</h4>
                            <p>Tough dimpled drainage board installed over the membrane. Sharp stones and equipment backfill bounce off without gouging the waterproof seal.</p>
                        </div>
                    </div>

                    <div class="blueprint-step-card">
                        <span class="step-num">04</span>
                        <div class="step-body">
                            <h4>Laser-Graded Washed Stone French Drain</h4>
                            <p>Perforated drainage pipe bedded in washed river gravel and wrapped in filter fabric catches groundwater and evacuates it safely away.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT VISUAL BLUEPRINT BOX -->
            <div class="blueprint-visual-box">
                <span class="blueprint-badge">📐 Trade Field Specifications</span>
                <h3>Engineered for Tennessee Clay</h3>
                <p>
                    Southeast Tennessee's heavy red clay exerts intense lateral hydrostatic pressure and expands dramatically during wet winters. Minimum-code systems fail here. Southern Shield is built specifically for this regional soil.
                </p>

                <ul class="technical-specs-list">
                    <li><span>Membrane Chemistry</span> <strong>Elastomeric Rubber Polymer</strong></li>
                    <li><span>Elongation / Stretch Capacity</span> <strong>Up to 800% Without Tearing</strong></li>
                    <li><span>Backfill Impact Resistance</span> <strong>Heavy Dimpled HDPE Core</strong></li>
                    <li><span>Footing Drainage Aggregate</span> <strong>#57 Washed Crushed River Rock</strong></li>
                    <li><span>Owner Supervision</span> <strong>100% On-Site by Scotty Barrera</strong></li>
                </ul>

                <div style="margin-top: 2rem;">
                    <a href="tel:@BusinessConfig.Value.PhoneNumber" class="btn btn-safety" style="width: 100%; justify-content: center;">
                        <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1C10.61 21 3 13.39 3 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.25 1.01l-2.2 2.2z"/></svg>
                        <span>Discuss Your Blueprints with Scotty</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- SECTION 4: EDUCATIONAL CONTRAST -->
<section class="trade-contrast-section">
    <div class="container">
        <div class="section-header-clean">
            <span class="section-tag-trade">Builder Education</span>
            <h2 class="section-title-clean">Why Standard Dampproofing Tar Fails</h2>
            <p class="section-subtitle-clean">
                Understand the vital difference between minimum-code builder tar and commercial polymer waterproofing.
            </p>
        </div>

        <div class="contrast-grid">
            <div class="contrast-box box-failure">
                <span class="contrast-badge badge-bad">⚠️ Standard Builder Dampproofing Tar</span>
                <h3>Asphalt Emulsion Tar</h3>
                <p>
                    Cheap petroleum tar sprayed by volume builders to pass basic inspection. It is dampproofing, NOT waterproofing.
                </p>
                <ul class="contrast-points">
                    <li><span class="point-x">✕</span> <strong>Becomes Brittle:</strong> Dries out and oxidizes within 2 to 3 years after burial.</li>
                    <li><span class="point-x">✕</span> <strong>Zero Elasticity:</strong> Normal foundation settling cracks tear right through brittle tar.</li>
                    <li><span class="point-x">✕</span> <strong>Leaves Footing Seam Bare:</strong> The critical cold joint is neglected, allowing water to wick up.</li>
                    <li><span class="point-x">✕</span> <strong>Easily Scraped by Rocks:</strong> Sharp backfill clay and stones easily puncture unprotected tar.</li>
                </ul>
            </div>

            <div class="contrast-box box-success">
                <span class="contrast-badge badge-good">🛡️ The Southern Shield Standard</span>
                <h3>Commercial Polymer Membrane</h3>
                <p>
                    A high-performance elastomeric rubber barrier engineered for brutal hydrostatic pressure and lifelong performance.
                </p>
                <ul class="contrast-points">
                    <li><span class="point-check">✓</span> <strong>Permanent Elasticity:</strong> Stretches 800% over settling cracks without leaking.</li>
                    <li><span class="point-check">✓</span> <strong>True Waterproofing:</strong> Impermeable rubber skin seals against subterranean water pressure.</li>
                    <li><span class="point-check">✓</span> <strong>Keyway Hydro-Stop:</strong> Dedicated footing cold-joint water barrier stops upward wicking.</li>
                    <li><span class="point-check">✓</span> <strong>Dimple Board Protection:</strong> Machine backfill and rocks cannot touch the waterproof seal.</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- SECTION 5: REAL JOB SITES -->
<section class="gallery-preview-section">
    <div class="container">
        <div class="section-header-clean">
            <span class="section-tag-trade">Recent Regional Work</span>
            <h2 class="section-title-clean">Job-Site Photo Gallery</h2>
            <p class="section-subtitle-clean">
                Real foundations prepped, waterproofed, and drained by Scotty Barrera across Southeast Tennessee.
            </p>
        </div>

        @if (HomeConfig.Value.Gallery != null && HomeConfig.Value.Gallery.Any())
        {
            <div class="gallery-grid">
                @foreach (var item in HomeConfig.Value.Gallery.Take(4))
                {
                    <div class="gallery-item">
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <div class="gallery-img-box">
                                <img src="@item.ImageUrl" alt="@item.Title" loading="lazy" />
                                <span class="gallery-cat">@item.Category</span>
                            </div>
                        }
                        <div class="gallery-meta">
                            <h4>@item.Title</h4>
                            <span class="gallery-loc">📍 @item.Location</span>
                            <p>@item.Description</p>
                        </div>
                    </div>
                }
            </div>
        }

        <div style="text-align: center; margin-top: 2.5rem;">
            <a href="@BusinessConfig.Value.FacebookUrl" target="_blank" rel="noopener" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 0.6rem;">
                <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z"/></svg>
                <span>Browse All Recent Job-Site Photos on Facebook &rarr;</span>
            </a>
        </div>
    </div>
</section>

<!-- SECTION 6: MEET SCOTTY BARRERA -->
<section class="owner-section">
    <div class="container">
        <div class="owner-box">
            <div class="owner-photo-col">
                <img src="images/scotty-barrera.jpg" alt="Scotty Barrera" class="owner-photo" />
                <span class="owner-name">Scotty Barrera</span>
                <span class="owner-title">Owner &amp; On-Site Contractor</span>
            </div>
            <div class="owner-content">
                <span class="section-tag-trade">Direct Contractor Accountability</span>
                <h3>"I am personally on your job site."</h3>
