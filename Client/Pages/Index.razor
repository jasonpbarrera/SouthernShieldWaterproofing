                <div class="owner-actions">
                    <a href="tel:@BusinessConfig.Value.PhoneNumber" class="btn btn-safety">
                        <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1C10.61 21 3 13.39 3 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.25 1.01l-2.2 2.2z"/></svg>
                        <span>Call Scotty: @BusinessConfig.Value.PhoneNumber</span>
                    </a>
                    <a href="/about" class="btn btn-secondary">
                        <span>Read Scotty's Story &rarr;</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- SECTION 7: TESTIMONIALS -->
@if (HomeConfig.Value.Testimonials != null && HomeConfig.Value.Testimonials.Any())
{
    <section class="reviews-section">
        <div class="container">
            <div class="section-header-clean">
                <span class="section-tag-trade">Verified Local Feedback</span>
                <h2 class="section-title-clean">What Builders &amp; Homeowners Say</h2>
            </div>

            <div class="reviews-grid">
                @foreach (var t in HomeConfig.Value.Testimonials)
                {
                    <div class="review-card">
                        <div class="review-stars">★★★★★</div>
                        <p class="review-quote">"@t.Quote"</p>
                        <div class="review-author">@t.Author</div>
                        <div class="review-meta">@t.Location &bull; @t.ProjectType</div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- SECTION 8: SERVICE AREA & DIRECT CTA -->
<section class="service-area-strip">
    <div class="container">
        <h2 style="font-family: var(--font-heading); font-size: 2rem; font-weight: 900; text-transform: uppercase; margin-bottom: 0.5rem; color: #ffffff;">Proudly Serving Southeast Tennessee</h2>
        <p style="color: #cbd5e1; max-width: 650px; margin: 0 auto;">Based in Bradley County, we travel throughout the region to deliver commercial-grade foundation defense.</p>
        
        <div class="area-cloud">
            @if (HomeConfig.Value.ServiceAreas != null)
            {
                @foreach (var area in HomeConfig.Value.ServiceAreas)
                {
                    <span class="area-pill">📍 @area, TN</span>
                }
            }
        </div>

        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
            <a href="tel:@BusinessConfig.Value.PhoneNumber" class="btn btn-safety">
                <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1C10.61 21 3 13.39 3 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.25 1.01l-2.2 2.2z"/></svg>
                <span>Call Scotty: @BusinessConfig.Value.PhoneNumber</span>
            </a>
            <a href="/contact" class="btn btn-secondary">Request Free Inspection Online</a>
        </div>
    </div>
</section>

@code {
    private string leadName = "";
    private string leadPhone = "";
    private string leadService = "New Foundation Waterproofing";
    private string leadCity = "";
    private bool isSubmitting = false;
    private bool isSubmitted = false;
    private string? submissionError;

    private async Task SubmitQuickInspectionAsync()
    {
        if (string.IsNullOrWhiteSpace(leadName) || string.IsNullOrWhiteSpace(leadPhone))
            return;

        isSubmitting = true;
        submissionError = null;

        var payload = new
        {
            BusinessId = BusinessConfig.Value.BusinessId,
            CompanyName = BusinessConfig.Value.CompanyName,
            Name = leadName,
            Phone = leadPhone,
            Email = $"{leadPhone.Replace("-","").Replace(" ","")}@inspection.southernshield.com",
            PreferredContactMethod = "Phone Call",
            ServiceType = leadService,
            Message = $"Homepage Quick Inspection Request for {leadService} in {leadCity}.",
            Honeypot = ""
        };

        try
        {
            var response = await Http.PostAsJsonAsync(ContactConfig.Value.ApiEndpoint, payload);
            if (response.IsSuccessStatusCode)
            {
                isSubmitted = true;
            }
            else
            {
                submissionError = $"Unable to send request online. Please call Scotty directly at {BusinessConfig.Value.PhoneNumber}.";
            }
        }
        catch
        {
            // If offline or CORS, still provide positive guidance
            submissionError = $"Please call Scotty directly at {BusinessConfig.Value.PhoneNumber} to schedule.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ResetIntakeForm()
    {
        leadName = "";
        leadPhone = "";
        leadCity = "";
        isSubmitted = false;
        submissionError = null;
    }
}
