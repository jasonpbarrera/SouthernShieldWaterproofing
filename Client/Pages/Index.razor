@page "/"
@inject IOptions<BusinessSettings> BusinessConfig
@inject IOptions<HomePageSettings> HomeConfig

<PageTitle>@BusinessConfig.Value.ShortName | @BusinessConfig.Value.CompanyName</PageTitle>

<!-- HERO SECTION -->
<section class="hero-section">
    <div class="hero-content">
        <h1>@BusinessConfig.Value.CompanyName</h1>
        <p class="tagline">@BusinessConfig.Value.Tagline</p>
        <p class="hero-description">@HomeConfig.Value.HeroDescription</p>
        <div class="hero-actions">
            <a href="/contact" class="btn btn-primary">@HomeConfig.Value.PrimaryCtaText</a>
            <a href="/about" class="btn btn-secondary">@HomeConfig.Value.SecondaryCtaText</a>
        </div>
    </div>
</section>

<!-- VALUES SECTION -->
@if (!string.IsNullOrWhiteSpace(HomeConfig.Value.ValuesHeading))
{
    <section class="values-section">
        <h2>@HomeConfig.Value.ValuesHeading</h2>
        <p class="values-subtitle">@HomeConfig.Value.ValuesSubtitle</p>
    </section>
}

<!-- MISSION PILLARS SECTION -->
<section class="pillars-section">
    @foreach (var pillar in HomeConfig.Value.Pillars)
    {
        <div class="pillar-card">
            <div class="icon-placeholder">@pillar.Icon</div>
            <h3>@pillar.Title</h3>
            <p>@pillar.Description</p>
        </div>
    }
</section>

@if (!string.IsNullOrWhiteSpace(HomeConfig.Value.StoryQuote))
{
    <section class="our-story-section">
        <div class="container">
            <h2>@HomeConfig.Value.StoryHeading</h2>
            <p class="our-story-quote">"@HomeConfig.Value.StoryQuote"</p>
            <p><strong>- @HomeConfig.Value.StoryAttribution</strong></p>
        </div>
    </section>
}

<!-- CUSTOMER REVIEWS & TESTIMONIALS -->
@if (HomeConfig.Value.Testimonials != null && HomeConfig.Value.Testimonials.Any())
{
    <section class="reviews-section">
        <h2>What Our Neighbors Say</h2>
        <p class="reviews-subtitle">Real feedback from homeowners and builders across Southeast Tennessee</p>
        <div class="reviews-grid">
            @foreach (var review in HomeConfig.Value.Testimonials)
            {
                <div class="review-card">
                    <div>
                        <div class="review-stars">
                            @for (int i = 0; i < review.Rating; i++)
                            {
                                <span>★</span>
                            }
                        </div>
                        <p class="review-quote">"@review.Quote"</p>
                    </div>
                    <div>
                        <div class="review-author">@review.Author</div>
                        <div class="review-meta">@review.Location • @review.ProjectType</div>
                    </div>
                </div>
            }
        </div>
        <div class="review-cta">
            <a href="@BusinessConfig.Value.FacebookUrl" target="_blank" rel="noopener" class="btn btn-secondary">
                View More Reviews & Photos on Facebook →
            </a>
        </div>
    </section>
}

<!-- FAQ SECTION -->
@if (HomeConfig.Value.Faqs != null && HomeConfig.Value.Faqs.Any())
{
    <section class="faq-section">
        <h2>Frequently Asked Questions</h2>
        <div class="faq-list">
            @foreach (var faq in HomeConfig.Value.Faqs)
            {
                <details class="faq-item">
                    <summary>@faq.Question</summary>
                    <p>@faq.Answer</p>
                </details>
            }
        </div>
    </section>
}

<!-- REGIONAL SERVICE AREAS -->
@if (HomeConfig.Value.ServiceAreas != null && HomeConfig.Value.ServiceAreas.Any())
{
    <section class="service-areas-section">
        <h2>Serving Southeast Tennessee</h2>
        <p>Reliable on-site consultations, footer treatments, and French drains throughout our region:</p>
        <div class="area-tags">
            @foreach (var area in HomeConfig.Value.ServiceAreas)
            {
                <span class="area-tag">📍 @area</span>
            }
        </div>
    </section>
}

