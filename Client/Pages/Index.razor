<!-- SECTION 8: SERVICE AREA & DIRECT CTA -->
<section class="service-area-strip">
    <div class="container">
        <h2 style="font-family: var(--font-heading); font-size: 2rem; font-weight: 900; text-transform: uppercase; margin-bottom: 0.5rem; color: #ffffff;">Proudly Serving Southeast Tennessee</h2>
