@page "/about"
@inject IOptions<BusinessSettings> BusinessConfig
@inject IOptions<AboutPageSettings> AboutConfig

<PageTitle>About Scotty Barrera | @BusinessConfig.Value.ShortName</PageTitle>

<div class="about-page-wrapper">
    <!-- HERO HEADER -->
    <section class="about-hero-header">
        <div class="content-container">
            <div class="industrial-kicker industrial-kicker-hazard">On-Site Leadership &amp; Foundation Defense</div>
            <h1 class="about-hero-title">MEET SCOTTY BARRERA</h1>
            <p class="about-hero-lead">
                Owner, operator, and on-site foundation waterproofing specialist behind Southern Shield Waterproofing in Southeast Tennessee.
            </p>
        </div>
    </section>

    <div class="content-container">
        <!-- FOUNDER SPOTLIGHT CARD -->
        <div class="founder-spotlight-card">
            <div class="founder-badge-column">
                <div class="founder-portrait-box">
                    <img src="images/scotty-barrera.jpg" alt="Scotty Barrera, Owner & Founder" class="founder-portrait" />
                </div>
                <div class="founder-id-box">
                    <h3>SCOTTY BARRERA</h3>
                    <span class="founder-role">Owner &amp; Operator</span>
                    <span class="founder-location">📍 Cleveland &amp; Chattanooga, TN</span>
                    <a href="tel:@BusinessConfig.Value.PhoneNumber" class="founder-phone-btn">
                        📞 (423) 661-9481
                    </a>
                </div>
            </div>

            <div class="founder-bio-column">
                <div class="industrial-kicker">Hands-On Waterproofing Contractor</div>
                <h2>"QUALITY AND INTEGRITY FROM FOOTING TO FINISH."</h2>
                <p>
                    When you hire Southern Shield Waterproofing, you don't get a middleman salesman or an inexperienced subcontracted crew. <strong>Scotty Barrera is on the job site personally managing every phase of your project</strong>—from the deep footing trench cleanout and cold-joint waterstop application to high-pressure elastomeric membrane spraying and gravel-bedded French drain routing.
                </p>
                <p>
                    Based in Bradley County and serving Cleveland, Chattanooga, Ooltewah, and across Southeast Tennessee, Scotty founded Southern Shield on an uncompromising commitment to structural foundation protection. Whether sealing custom mountain homes in Signal Mountain, waterproofing multi-tier basements in Chattanooga, or installing heavy backfill armor boards for builders in Cleveland, Scotty brings specialized craftsmanship and honesty to every square foot.
                </p>

                <div class="founder-creds-grid">
                    <div class="cred-item">
                        <strong>100% Owner Supervised</strong>
                        <span>Scotty is on-site verifying surface prep, dry-mil coating thickness, and slope.</span>
                    </div>
                    <div class="cred-item">
                        <strong>Commercial Polymer Barrier</strong>
                        <span>Seamless elastomeric spray membranes engineered for brutal hydrostatic pressure.</span>
                    </div>
                    <div class="cred-item">
                        <strong>Turnkey Moisture Defense</strong>
                        <span>Footing waterstops, wall membranes, gravel-bedded French drains, and armor boards.</span>
                    </div>
                    <div class="cred-item">
                        <strong>East Tennessee Terrain Specialists</strong>
                        <span>Deep expertise with regional red clay, chert, limestone shelves, and mountain runoff.</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- FAMILY VALUES CARD -->
        <div class="family-values-card">
            <div class="family-img-box">
                <img src="images/scotty-family.jpg" alt="Scotty & Gracie Barrera Family" loading="lazy" />
            </div>
            <div class="family-content-box">
                <div class="industrial-kicker">Rooted in Southeast Tennessee</div>
                <h2>FAMILY VALUES, UNCOMPROMISING PROTECTION</h2>
                <p>
                    Southern Shield Waterproofing is locally owned and operated right here at home by Scotty and Gracie Barrera. We treat every foundation, basement, and crawlspace as if it were sheltering our own family.
                </p>
                <p>
                    When you contact Southern Shield, you speak directly with Scotty. No high-pressure sales pitches, no confusing corporate tiers—just honest advice, transparent proposals, and dependable execution that keeps your home bone-dry for decades.
                </p>
                <div class="family-badges-list">
                    <span>✓ Direct Owner Oversight</span>
                    <span>✓ Honest, Upfront Pricing</span>
                    <span>✓ Built for Tennessee Terrain</span>
                    <span>✓ Licensed &amp; Insured</span>
                </div>
            </div>
        </div>

        <!-- ON-SITE CRAFTSMANSHIP SHOWCASE -->
        <div class="craftsmanship-showcase-section">
            <div class="showcase-header">
                <div class="industrial-kicker">Precision Moisture Defense</div>
                <h2>THE SOUTHERN SHIELD DIFFERENCE ON THE JOB SITE</h2>
                <p>
                    See the commercial spray equipment, continuous elastomeric placement, and finished foundation protection systems built by Scotty and the crew across Southeast Tennessee.
                </p>
            </div>

            <div class="showcase-dual-cards">
                <div class="showcase-card">
                    <div class="showcase-img-box">
                        <img src="images/projects/project-1.jpg" alt="Seamless Spray-Applied Wall Membrane by Scotty Barrera" loading="lazy" />
                    </div>
                    <div class="showcase-body">
                        <h3>Seamless Polymer Wall Membrane</h3>
                        <p>High-capacity spray applicator coats porous CMU blocks and mortar seams in a continuous, flexible rubberized membrane that stops subterranean hydrostatic water penetration.</p>
                        <span class="showcase-tag">📍 Chattanooga, TN</span>
                    </div>
                </div>

                <div class="showcase-card">
                    <div class="showcase-img-box">
                        <img src="images/projects/project-4.jpg" alt="Deep Footing Trench Excavation and Cold Joint Seal" loading="lazy" />
                    </div>
                    <div class="showcase-body">
                        <h3>Footing Cold-Joint Sealing</h3>
                        <p>Excavated foundation footing cleared of soil and prepped with specialized elastomeric waterstop seals, permanently eliminating upward capillary wicking at the wall base.</p>
                        <span class="showcase-tag">📍 Signal Mountain, TN</span>
                    </div>
                </div>

                <div class="showcase-card">
                    <div class="showcase-img-box">
                        <img src="images/projects/project-3.jpg" alt="Footing French Drain System with Washed Stone" loading="lazy" />
                    </div>
                    <div class="showcase-body">
                        <h3>Engineered French Drainage</h3>
                        <p>Perforated footing pipe encased in clean washed river gravel and geotextile filter fabric to capture groundwater and discharge it safely away by continuous gravity flow.</p>
                        <span class="showcase-tag">📍 Ooltewah, TN</span>
                    </div>
                </div>

                <div class="showcase-card">
                    <div class="showcase-img-box">
                        <img src="images/projects/project-2.jpg" alt="Dimpled Drainage Armor Board Installation" loading="lazy" />
                    </div>
                    <div class="showcase-body">
                        <h3>Heavy Backfill Armor Shield</h3>
                        <p>High-density dimpled drainage core sheets protecting freshly cured membrane coatings from sharp rock punctures, roots, and heavy equipment soil backfill compaction.</p>
                        <span class="showcase-tag">📍 Cleveland, TN</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- CALL TO ACTION -->
        <div class="about-cta-bar">
            <div>
                <h3>DISCUSS YOUR UPCOMING FOUNDATION WITH SCOTTY</h3>
                <p>Have blueprints, new construction plans, or moisture questions about your foundation? Call Scotty directly today.</p>
            </div>
            <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
                <a href="tel:@BusinessConfig.Value.PhoneNumber" class="btn btn-primary">Call Scotty: @BusinessConfig.Value.PhoneNumber</a>
                <a href="/contact" class="btn btn-secondary">Submit Project Plans</a>
            </div>
        </div>
    </div>
</div>
