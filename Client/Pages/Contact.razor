@page "/contact"
@inject IOptions<BusinessSettings> BusinessConfig
@inject IOptions<ContactPageSettings> ContactConfig
@inject HttpClient Http

<PageTitle>Request an Estimate | @BusinessConfig.Value.ShortName</PageTitle>

<div class="contact-page-wrapper">
    <!-- HERO HEADER -->
    <section class="contact-hero-header">
        <div class="content-container">
            <div class="industrial-kicker industrial-kicker-hazard">Direct Contractor Communication</div>
            <h1 class="contact-hero-title">REQUEST A FREE WATERPROOFING ESTIMATE</h1>
            <p class="contact-hero-lead">
                Scotty Barrera personally reviews all foundation plans, footing specs, site drainage photos, and inspection requests.
            </p>
        </div>
    </section>

    <div class="content-container">
        <div class="contact-grid">
            <!-- Left Side: Contractor Info -->
            <div class="contact-info-col">
                <div class="contractor-card">
                    <div class="industrial-kicker">Direct Contact</div>
                    <h2>TALK TO SCOTTY DIRECTLY</h2>
                    <p>
                        Have questions about new construction foundation waterproofing, footing cold joints, or persistent basement moisture? Call Scotty Barrera directly on his mobile line.
                    </p>

                    <div class="contact-action-box">
                        <span class="action-label">MOBILE / DIRECT LINE</span>
                        <a href="tel:@BusinessConfig.Value.PhoneNumber" class="direct-phone-link">
                            📞 @BusinessConfig.Value.PhoneNumber
                        </a>
                    </div>

                    <div class="contact-action-box">
                        <span class="action-label">EMAIL BLUEPRINTS &amp; SPECS</span>
                        <a href="mailto:@BusinessConfig.Value.PrimaryEmail" class="direct-email-link">
                            ✉️ @BusinessConfig.Value.PrimaryEmail
                        </a>
                    </div>

                    <div class="contact-meta-list">
                        <div class="meta-item">
                            <strong>Service Base:</strong>
                            <span>Cleveland &amp; Chattanooga, TN</span>
                        </div>
                        <div class="meta-item">
                            <strong>Regional Coverage:</strong>
                            <span>Bradley, Hamilton, McMinn, Meigs, Polk, Rhea &amp; Marion Counties</span>
                        </div>
                        <div class="meta-item">
                            <strong>Response Time:</strong>
                            <span>On-site consultations typically scheduled within 24–48 hours</span>
                        </div>
                        <div class="meta-item">
                            <strong>Operating Hours:</strong>
                            <span>Monday – Friday: 7:00 AM – 6:00 PM<br />Saturday: By Appointment</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Side: The Form -->
            <div class="contact-form-col">
                <div class="form-wrapper-card">
                    @if (isSubmitted)
                    {
                        <div class="success-message-box">
                            <div class="success-check-icon">✓</div>
                            <h3>ESTIMATE REQUEST RECEIVED</h3>
                            <p>Thank you for reaching out. Scotty Barrera has received your project details and will review your specifications and follow up promptly.</p>
                            <p style="font-size: 0.95rem; color: #64748b; margin-top: 1rem;">Need immediate answers? Call Scotty directly at <strong>@BusinessConfig.Value.PhoneNumber</strong>.</p>
                            <button class="btn btn-primary" style="margin-top: 1.5rem;" @onclick="ResetForm">Submit Another Inquiry</button>
                        </div>
                    }
                    else
                    {
                        <form @onsubmit="SubmitForm" class="industrial-form">
                            <!-- Bot Protection Honeypot -->
                            <input type="text" @bind="botHoneypot" class="visually-hidden" tabindex="-1" autocomplete="off" />

                            <div class="form-header">
                                <h3>PROJECT DETAILS &amp; SPECIFICATIONS</h3>
                                <p>Fill out the form below and Scotty will follow up promptly with your estimate.</p>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(errorMessage))
                            {
                                <div class="error-banner" role="alert">
                                    @errorMessage
                                </div>
                            }

                            <div class="form-row">
                                <div class="form-group">
                                    <label for="name">Your Name / Builder Name *</label>
                                    <input type="text" id="name" @bind="name" required placeholder="John Doe or Homeowner Name" />
                                </div>
                                <div class="form-group">
                                    <label for="phone">Phone Number *</label>
                                    <input type="tel" id="phone" @bind="phoneNumber" required placeholder="(423) 555-0123" />
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label for="email">Email Address *</label>
                                    <input type="email" id="email" @bind="email" required placeholder="john@example.com" />
                                </div>
                                <div class="form-group">
                                    <label for="serviceType">@ContactConfig.Value.ServiceSelectLabel *</label>
                                    <select id="serviceType" @bind="serviceType" required>
                                        <option value="">Select Waterproofing Service...</option>
                                        @foreach (var option in ContactConfig.Value.ServiceOptions)
                                        {
                                            <option value="@option">@option</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label for="contactMethod">Preferred Response Method</label>
                                    <select id="contactMethod" @bind="contactMethod">
                                        @foreach (var method in ContactConfig.Value.ContactMethods)
                                        {
                                            <option value="@method">@method</option>
                                        }
                                    </select>
                                </div>
                                @if (ContactConfig.Value.ShowStartDate)
                                {
                                    <div class="form-group">
                                        <label for="startDate">@ContactConfig.Value.StartDateLabel</label>
                                        <input type="date" id="startDate" @bind="startDate" required="@ContactConfig.Value.StartDateRequired" />
                                    </div>
                                }
                            </div>

                            <div class="form-group">
                                <label for="message">Project Description, Foundation Scope &amp; Location *</label>
                                <textarea id="message" @bind="message" required rows="5" placeholder="Share foundation details (e.g. new construction basement, footing depth, French drain route, hill slope, city/county, or blueprint specs)..."></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary submit-btn" disabled="@isSubmitting">
                                @(isSubmitting ? "TRANSMITTING TO SCOTTY..." : "SUBMIT ESTIMATE REQUEST")
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string name = "";
    private string phoneNumber = "";
    private string email = "";
    private string contactMethod = "Phone Call";
    private string serviceType = "";
    private DateTime? startDate = null;
    private string message = "";
    private string botHoneypot = "";
    private string? errorMessage = null;

    private bool isSubmitted = false;
    private bool isSubmitting = false;

    private async Task SubmitForm()
    {
        isSubmitting = true;
        errorMessage = null;

        // Bot trap: If filled, fake a successful submission and exit
        if (!string.IsNullOrEmpty(botHoneypot))
        {
            isSubmitted = true;
            isSubmitting = false;
            return;
        }

        var payload = new LeadSubmissionRequest
        {
            BusinessId = BusinessConfig.Value.BusinessId,
            CompanyName = BusinessConfig.Value.CompanyName,
            Name = name,
            Phone = phoneNumber,
            Email = email,
            PreferredContactMethod = contactMethod,
            ServiceType = serviceType,
            PreferredStartDate = startDate?.ToString("yyyy-MM-dd"),
            Message = message,
            Honeypot = botHoneypot
        };

        try
        {
            var response = await Http.PostAsJsonAsync(ContactConfig.Value.ApiEndpoint, payload);
            if (response.IsSuccessStatusCode)
            {
                isSubmitted = true;
            }
            else
            {
                errorMessage = $"We couldn't submit your request right now. Please call Scotty directly at {BusinessConfig.Value.PhoneNumber}.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Submission failed: {ex.Message}");
            errorMessage = $"Network error while sending your message. Please call Scotty directly at {BusinessConfig.Value.PhoneNumber}.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ResetForm()
    {
        name = "";
        phoneNumber = "";
        email = "";
        contactMethod = "Phone Call";
        serviceType = "";
        startDate = null;
        message = "";
        botHoneypot = "";
        errorMessage = null;
        isSubmitted = false;
    }
}
