@inherits LayoutComponentBase
@using System.Reflection
@inject IOptions<BusinessSettings> BusinessConfig
@inject IOptions<ThemeSettings> ThemeConfig
@inject IOptions<AboutPageSettings> AboutConfig

<div class="page" style="--brand-primary: @ThemeConfig.Value.PrimaryColor; --brand-accent: @ThemeConfig.Value.AccentColor; --brand-surface: @ThemeConfig.Value.SurfaceColor; --brand-bg: @ThemeConfig.Value.BackgroundColor;">
    <header class="site-header">
        <div class="header-top-bar">
            <a href="tel:@BusinessConfig.Value.PhoneNumber" style="color: inherit; display: inline-flex; align-items: center; gap: 0.4rem;">
                <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1C10.61 21 3 13.39 3 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.25 1.01l-2.2 2.2z"/></svg>
                @BusinessConfig.Value.PhoneNumber
            </a>
            <a href="mailto:@BusinessConfig.Value.PrimaryEmail" style="color: inherit; display: inline-flex; align-items: center; gap: 0.4rem;">
                <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
                @BusinessConfig.Value.PrimaryEmail
            </a>
        </div>

        <div class="navbar">
            <div class="brand-container">
                <a class="navbar-brand" href="/">
                    <img src="@BusinessConfig.Value.LogoUrl" alt="@BusinessConfig.Value.ShortName" style="height: 60px; width: auto; border-radius: 8px; object-fit: contain;" />
                </a>
                <span class="brand-tagline">@BusinessConfig.Value.Tagline</span>
            </div>

            <nav class="main-navigation">
                <NavLink href="/" Match="NavLinkMatch.All">Home</NavLink>
                <NavLink href="/about">@AboutConfig.Value.NavTitle</NavLink>
                <NavLink href="/services">Services</NavLink>
                <NavLink href="/contact">Contact</NavLink>
            </nav>
        </div>
    </header>

    <main class="main-content">
        @Body
    </main>

    <footer class="site-footer">
        <div class="footer-inner">
            <div class="footer-brand">
                <h3>@BusinessConfig.Value.CompanyName</h3>
                <p>@BusinessConfig.Value.Tagline</p>
            </div>
            <div class="footer-contact">
                <p>Let's get in touch.</p>
                <a href="tel:@BusinessConfig.Value.PhoneNumber">@BusinessConfig.Value.PhoneNumber</a><br />
                <a href="mailto:@BusinessConfig.Value.PrimaryEmail">@BusinessConfig.Value.PrimaryEmail</a><br />
                <div class="social-links" style="margin-top: 0.75rem; display: flex; gap: 1rem; align-items: center;">
                    @if (!string.IsNullOrWhiteSpace(BusinessConfig.Value.FacebookUrl))
                    {
                        <a href="@BusinessConfig.Value.FacebookUrl" target="_blank" rel="noopener" aria-label="Facebook" style="color: var(--brand-primary);">
                            <svg width="22" height="22" fill="currentColor" viewBox="0 0 24 24"><path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z" /></svg>
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(BusinessConfig.Value.InstagramUrl))
                    {
                        <a href="@BusinessConfig.Value.InstagramUrl" target="_blank" rel="noopener" aria-label="Instagram" style="color: var(--brand-primary);">
                            <svg width="22" height="22" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" /></svg>
                        </a>
                    }
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; @DateTime.Now.Year @BusinessConfig.Value.CompanyName. All rights reserved.</p>
            <span class="jb-footer-credit">
                v@(AppVersion) &middot; @BuildDate &middot; Powered by <a href="https://jbdigitalservices.net" target="_blank" rel="noopener noreferrer">JB Digital Technologies</a>
            </span>
        </div>
    </footer>
</div>

@code {
    private static readonly string AppVersion =
        typeof(MainLayout).Assembly.GetName().Version?.ToString(3) ?? "1.0.0";
    private static readonly string BuildDate =
        typeof(MainLayout).Assembly
            .GetCustomAttributes<AssemblyMetadataAttribute>()
            .FirstOrDefault(a => a.Key == "BuildTimestamp")?.Value
        ?? DateTime.UtcNow.ToString("MMM d, yyyy");
}
