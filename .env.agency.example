# ==============================================================================
# Master Agency API Keys (.env.agency)
# Copy this file to `.env.agency` (which is git-ignored) so `scripts/onboard-client.py`
# can manage clients, leads, billing, DNS, and email routing from one command.
# ==============================================================================

# 1. Azure Cosmos DB (Master Multi-Tenant Database: SmallBusinessPlatform)
COSMOS_CONNECTION_STRING="AccountEndpoint=https://your-cosmos-account.documents.azure.com:443/;AccountKey=your-primary-key;"
COSMOS_DATABASE_NAME="SmallBusinessPlatform"

# 2. Cloudflare API Token (Permissions: Zone:DNS:Edit, Zone:Email Routing Rules:Edit)
CLOUDFLARE_API_TOKEN=""

# 3. Brevo API Key (For Outbound Lead Alerts & Domain DKIM Verification)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="info@your-agency-or-client-domain.com"
